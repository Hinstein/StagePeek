# Node.js 24+; copy to .env. Never put secrets in public/.
HOST=127.0.0.1
PORT=4180
APP_URL=http://127.0.0.1:4180
# Production: APP_URL=https://stagepeek.live, NODE_ENV=production, DEV_MAILBOX=false
# Production must use the private PostgreSQL connection created by
# scripts/provision-postgres.mjs. Never put this value in browser code or Git.
DATABASE_URL=
DATABASE_SCHEMA=site_stagepeek
DATABASE_POOL_MAX=5
# SQLite remains available only for offline tests/local fallback when DATABASE_URL is empty.
NODE_ENV=development
# Explicit development-only outbox; /api/dev/mailbox is accessible from loopback only.
DEV_MAILBOX=true
# Comma-separated exact additional browser origins for LAN testing, e.g. http://192.168.6.150:4180
ALLOWED_ORIGINS=
# Comma-separated administrator emails allowed to validate/publish venue manifests.
ADMIN_EMAILS=
# Public website UUID from the existing platform Umami instance (no API key).
# Disabled unless configured on the production canonical homepage.
UMAMI_WEBSITE_ID=

# Brevo is the deployment platform's transactional email provider.
BREVO_API_KEY=
# Legacy fallback for local migrations; prefer Brevo in production.
RESEND_API_KEY=
EMAIL_FROM=
# Exactly ten venue ids for the initial free tier. Admin settings can replace this after boot.
FREE_VENUE_IDS=kai-tak-stadium,hong-kong-coliseum,asiaworld-arena,asiaworld-viva,asiaworld-summit-hall-2,asiaworld-runway-11,taipei-arena,tottenham,metlife,sofi
# Legacy Google client keys below are local-only. Production uses shared Supabase Google.
# Google console callback: https://supabase.openp7m.com/auth/v1/callback
# Shared Auth allow-list: https://stagepeek.live/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional server-side ticketing adapter. Never expose this key to the browser.
# Without it, cached official event/seat-map references continue to work.
TICKETMASTER_API_KEY=

# Use Stripe test keys first. Price must be active, recurring every 1 month.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
# Webhook: APP_URL/api/billing/webhook
# Enable Stripe Billing Portal in the same Stripe account.

# Unified shared Auth (production requires PostgreSQL migrations 002 and 003)
AUTH_MODE=supabase
SUPABASE_URL=https://supabase.openp7m.com
SUPABASE_ANON_KEY=
SITE_ID=472e7705-2a72-423d-8aad-cf59497ab4e9
# 32 random bytes, base64; server/Coolify secret only
AUTH_COOKIE_KEY=
# Enable after branded mail hook and sender are ready
AUTH_EMAIL_ENABLED=false

# Enable after shared provider / branded recovery mail registry is verified.
AUTH_RECOVERY_ENABLED=false
AUTH_GOOGLE_ENABLED=false
