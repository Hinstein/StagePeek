# Node.js 24+; copy to .env. Never put secrets in public/.
HOST=127.0.0.1
PORT=4180
APP_URL=http://127.0.0.1:4180
NODE_ENV=development
# Explicit development-only outbox; /api/dev/mailbox is accessible from loopback only.
DEV_MAILBOX=true
# Comma-separated exact additional browser origins for LAN testing, e.g. http://192.168.6.150:4180
ALLOWED_ORIGINS=
# Comma-separated administrator emails allowed to validate/publish venue manifests.
ADMIN_EMAILS=

# Brevo is the deployment platform's transactional email provider.
BREVO_API_KEY=
# Legacy fallback for local migrations; prefer Brevo in production.
RESEND_API_KEY=
EMAIL_FROM=
# Exactly ten venue ids for the initial free tier. Admin settings can replace this after boot.
FREE_VENUE_IDS=kai-tak-stadium,hong-kong-coliseum,asiaworld-arena,asiaworld-viva,asiaworld-summit-hall-2,asiaworld-runway-11,taipei-arena,tottenham,metlife,sofi
# Google web client callback: APP_URL/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional server-side ticketing adapter. Never expose this key to the browser.
# Without it, cached official event/seat-map references continue to work.
TICKETMASTER_API_KEY=

# Use Stripe test keys first. Price must be active, recurring every 1 month.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
# Webhook: APP_URL/api/billing/webhook
# Enable Stripe Billing Portal in the same Stripe account.
