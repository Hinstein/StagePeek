PREFIX wd: <http://www.wikidata.org/entity/>
PREFIX wdt: <http://www.wikidata.org/prop/direct/>
PREFIX wikibase: <http://wikiba.se/ontology#>
PREFIX bd: <http://www.bigdata.com/rdf#>
SELECT DISTINCT ?venue ?venueLabel ?country ?countryLabel ?type ?coordinate ?website WHERE {
 VALUES ?country {wd:Q30 wd:Q16 wd:Q145 wd:Q142 wd:Q183 wd:Q55}
 VALUES ?type {wd:Q483110 wd:Q641226}
 ?venue wdt:P31 ?type; wdt:P17 ?country; wdt:P625 ?coordinate.
 OPTIONAL {?venue wdt:P856 ?website}
 SERVICE wikibase:label {bd:serviceParam wikibase:language "en".}
}
LIMIT 300
